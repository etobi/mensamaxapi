# ---- Mensamax -------------------------------------------------------------
# Base URL of the Mensamax web app (the mobile/GraphQL endpoint).
MENSAMAX_BASE_URL=https://m.mensamax.de

# Comma separated account ids. Each id becomes part of the Home Assistant entity ids
# (sensor.mensamax_<id>_kontostand ...). Only a-z, 0-9 and underscore.
MENSAMAX_ACCOUNTS=anna,ben

# Defaults for all accounts. Any key can be overridden per account with MENSAMAX_<ID>_<KEY>.
MENSAMAX_PROJECT=ABC123
# ISO weekdays (1 = Monday ... 7 = Sunday) on which an order is mandatory / optional.
MENSAMAX_REQUIRED_WEEKDAYS=2,3,4
MENSAMAX_OPTIONAL_WEEKDAYS=1
# "Guthaben niedrig" turns on when the current balance drops below this amount (EUR).
MENSAMAX_LOW_BALANCE=20
# "Menüprüfung fällig" turns on this many days before the order deadline of the next editable week.
MENSAMAX_REVIEW_WINDOW_DAYS=3
# How many weeks (starting with the current one) are fetched. Minimum 3.
MENSAMAX_LOOKAHEAD_WEEKS=4

MENSAMAX_ANNA_NAME=Anna
MENSAMAX_ANNA_USERNAME=anna.login
MENSAMAX_ANNA_PASSWORD=secret

MENSAMAX_BEN_NAME=Ben
MENSAMAX_BEN_USERNAME=ben.login
MENSAMAX_BEN_PASSWORD=secret
# MENSAMAX_BEN_PROJECT=XYZ789
# MENSAMAX_BEN_REQUIRED_WEEKDAYS=1,2,3,4,5

# ---- MQTT (Home Assistant Mosquitto add-on) --------------------------------
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=mqtt-user
MQTT_PASSWORD=secret
MQTT_TLS=false
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_TOPIC_PREFIX=mensamax
MQTT_CLIENT_ID=mensamax-ha

# ---- LLM for the short dish names -----------------------------------------
# none | claude | openai
LLM_PROVIDER=claude
# Leave empty for the provider default (claude-opus-5 / gpt-4o-mini).
LLM_MODEL=
LLM_API_KEY=sk-...
LLM_SHORT_MAX_LENGTH=30

# ---- Runtime ----------------------------------------------------------------
TZ=Europe/Berlin
# Where the short text cache is stored (inside Docker: /data).
#DATA_DIR=./data
